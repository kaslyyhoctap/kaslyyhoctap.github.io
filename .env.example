# ─── Database (Neon Postgres) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@db.aws-us-east-1.neon.tech/dbname?sslmode=require

# ─── NextAuth.js v5 (Google OAuth) ─────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                        # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Admin (owner) email for protected routes ─────────────────────────────
ADMIN_EMAIL=

# ─── Google AI Studio (free tier: 1000 req/day) ────────────────────────────
GOOGLE_AI_API_KEY=
